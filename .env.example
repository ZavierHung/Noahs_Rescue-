# 前端可选配置（默认即为此地址）
NEXT_PUBLIC_GAME_API_URL=http://localhost:8787

# API 可选配置
GAME_API_PORT=8787
# GAME_DATA_DIR=/absolute/path/to/local/json/data

# MiniMax Coding/Token Plan（把此文件复制为 .env 后填写）
# 国内使用 minimaxi.com；国际账号可改为 https://api.minimax.io/anthropic
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3.0
MINIMAX_TIMEOUT_MS=60000
