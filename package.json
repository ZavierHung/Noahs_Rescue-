{
  "name": "world-balance-system",
  "version": "0.4.1-local",
  "private": true,
  "type": "module",
  "scripts": {
    "knowledge:archive": "node scripts/archive-academic.mjs",
    "knowledge:archive:proxy": "node scripts/with-system-proxy.mjs archive-academic.mjs",
    "test:knowledge:live": "node scripts/smoke-academic-llm.mjs",
    "test:knowledge:live:proxy": "node scripts/with-system-proxy.mjs smoke-academic-llm.mjs",
    "test:knowledge": "node --test server/test/academic.test.js server/test/academic-coverage.test.js && node scripts/evaluate-academic.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:proxy": "node scripts/with-system-proxy.mjs dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "dev:web": "npm --prefix app run dev",
    "dev:api": "npm --prefix server run dev",
    "build": "npm --prefix app run build",
    "test": "npm --prefix server test",
    "test:simulation": "node scripts/simulate-expedition.mjs",
    "test:learning": "node scripts/evaluate-learning.mjs --learning --matches 20",
    "test:learning:live": "node scripts/simulate-learning-live.mjs",
    "test:learning:live:proxy": "node scripts/with-system-proxy.mjs simulate-learning-live.mjs",
    "test:balance": "node scripts/balance-expedition.mjs",
    "typecheck": "npm --prefix app exec tsc -- --noEmit -p app/tsconfig.json",
    "check": "npm test && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:game": "node --test server/test/expedition*.test.js",
    "test:technology": "node --test server/test/expedition-technology-options.test.js server/test/expedition-engine.test.js server/test/expedition-learning-rules.test.js && playwright test tests/browser/technology-actions.spec.js",
    "check:all": "npm run check && npm run test:e2e",
    "release:check": "node scripts/release-check.mjs && npm run check:all"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
