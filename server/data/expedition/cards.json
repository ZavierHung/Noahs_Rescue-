      "kind": "action",
      "type": "行动卡",
      "flavor": "送出资源，提出交换请求。",
      "effect": "尝试进行一次资源交换；若被拒绝，可再向其他玩家发出请求。",
      "condition": "对已建立联络的玩家使用。",
      "restriction": "对方可自由选择回应或拒绝。",
      "note": "适合用于试探立场或短期合作。",
      "status": {},
      "semantics": {
        "kind": "nearest_cooperative_grant",
        "nearestCount": 2,
        "requiresConsent": true,
        "resourceEach": 1,
        "independentResourceChoice": true,
        "retryAfterRejection": true
      },
      "width": 1061,
      "height": 1482,
      "image": "/images/expedition/cards/invitation.jpg",
      "sourceImage": "image14.png",
      "sourceCopies": 1,
      "implementedEffect": "选择物理位置最近的两名其他玩家之一（地图直线距离，同距按座位号），自己选一种资源。对方接受时独立选择一种，双方各新增一份；不需要库存，不是交换。接受后消耗邀约卡；拒绝不消耗、不发资源，可重试。社会失序的交易限制不影响此共同领取。"
    },
